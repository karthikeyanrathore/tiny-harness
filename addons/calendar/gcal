#!/bin/bash
# Sign in (login), or add, list or delete Google Calendar events; run with no arguments for usage.
# Installed (the launcher sets TINY_HARNESS_DATA_DIR and TINY_HARNESS_CONFIG_DIR): the per-user venv and
# config folder. Checkout: the project's .venv, with credentials.json and token.json in the project folder.
HERE=$(cd "$(dirname "$0")" && pwd)
if [ -n "${TINY_HARNESS_DATA_DIR:-}" ] && [ -n "${TINY_HARNESS_CONFIG_DIR:-}" ]; then
  PYTHON="$TINY_HARNESS_DATA_DIR/calendar/venv/bin/python3"
  CONFIG="$TINY_HARNESS_CONFIG_DIR/calendar"
else
  PYTHON="$HERE/../../.venv/bin/python3"
  CONFIG="$HERE/../.."
fi
if [ ! -x "$PYTHON" ]; then
  echo "Google Calendar is not set up yet. Run /install-gcal in tiny-harness (or: tiny-harness calendar-setup)" >&2
  exit 1
fi
mkdir -p "$CONFIG" && cd "$CONFIG" || exit 1
exec "$PYTHON" "$HERE/gcal_tool.py" "$@"
