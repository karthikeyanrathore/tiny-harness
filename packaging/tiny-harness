#!/bin/sh
# Launcher installed as /usr/bin/tiny-harness: runs the harness with the bundled Node and keeps
# per-user files in the XDG folders (sessions and the calendar venv in data, Google sign-in in config).
LIB=/usr/lib/tiny-harness
export TINY_HARNESS_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tiny-harness"
export TINY_HARNESS_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tiny-harness"
export TINY_HARNESS_PYTHON="$TINY_HARNESS_DATA_DIR/venv/bin/python3"
mkdir -p "$TINY_HARNESS_CONFIG_DIR"

case "$1" in
  -h|--help)
    cat <<'EOF'
Usage:
  tiny-harness                      start the harness in the current folder
  tiny-harness --resume <id>        continue a saved session
  tiny-harness calendar-setup       set up Google Calendar (once)
  tiny-harness gcal <command>       run the calendar script directly (login, add, list, delete)

Model settings: LLM_BASE_URL, LLM_MODEL, LLM_API_KEY (default: gemma4:31b-cloud through local Ollama).
EOF
    ;;
  calendar-setup)
    shift
    exec bash "$LIB/calendar-setup" "$@"
    ;;
  gcal)
    shift
    if [ ! -x "$TINY_HARNESS_PYTHON" ]; then
      echo "Google Calendar is not set up yet. Run: tiny-harness calendar-setup" >&2
      exit 1
    fi
    cd "$TINY_HARNESS_CONFIG_DIR" && exec "$TINY_HARNESS_PYTHON" "$LIB/scripts/gcal_tool.py" "$@"
    ;;
  *)
    exec "$LIB/node/bin/node" "$LIB/src/cli.ts" "$@"
    ;;
esac
